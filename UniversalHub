local itemList = makeList(itemsPage, 180)

local function isCandidateItem(instance)
    return instance:IsA("BasePart") and instance:IsDescendantOf(CONFIG.ItemSearchRoot)
end

local function rebuildItemList()
    clearList(itemList)
    state.detectedItems = {}
    local query, count = string.lower(itemSearch.Text), 0
    for _, instance in ipairs(CONFIG.ItemSearchRoot:GetDescendants()) do
        if isCandidateItem(instance) then
            local fullName = instance:GetFullName()
            local matches = query == ""
                or string.find(string.lower(instance.Name), query, 1, true)
                or string.find(string.lower(fullName), query, 1, true)
            if matches and count < CONFIG.ItemMaxResults then
                count += 1
                table.insert(state.detectedItems, instance)
                addListButton(itemList, instance.Name .. "  •  " .. fullName, function()
                    state.selectedItem = instance
                    manualItemName.Text = instance.Name
                    selectedItemLabel.Text = "Selected item: " .. fullName
                end)
            end
        end
    end
    if count == 0 then label(itemList, "No matching BaseParts found.", 28, 12, C.Muted) end
end

itemSearch:GetPropertyChangedSignal("Text"):Connect(rebuildItemList)
button(itemsPage, "Refresh item list", rebuildItemList)
button(itemsPage, "Find typed item name", function()
    local query = string.lower(manualItemName.Text)
    if query == "" then return end
    local found
    for _, instance in ipairs(CONFIG.ItemSearchRoot:GetDescendants()) do
        if isCandidateItem(instance) and string.lower(instance.Name) == query then
            found = instance
            break
        end
    end
    state.selectedItem = found
    selectedItemLabel.Text = found and ("Selected item: " .. found:GetFullName()) or "No exact item-name match found."
end, C.Accent)

