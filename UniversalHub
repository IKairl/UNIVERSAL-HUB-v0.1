local pages, tabs = {}, {}

local function createPage(name, order)
	local page = new("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Visible = false,
	}, content)
	addPadding(page, 12)
	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)
	pages[name] = page

	local tab = new("TextButton", {
		Name = name .. "Tab",
		Size = UDim2.fromOffset(126, 34),
		BackgroundColor3 = T.Surface,
		BorderSizePixel = 0,
		Text = name,
		TextColor3 = T.Muted,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		LayoutOrder = order,
	}, tabBar)
	addCorner(tab, 8)
	tabs[name] = tab

	tab.Activated:Connect(function()
		for pageName, pageObject in pairs(pages) do
			pageObject.Visible = (pageName == name)
			tabs[pageName].BackgroundColor3 = pageName == name and T.Accent or T.Surface
			tabs[pageName].TextColor3 = pageName == name and T.Text or T.Muted
		end
		page.CanvasPosition = Vector2.zero
	end)
	return page
end

