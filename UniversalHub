local SpectateButton
SpectateButton = CreateButton(PlayersPage, "Spectate Selected Player", function()
	local camera = workspace.CurrentCamera
	if not camera then return end

	if State.Spectating then
		State.Spectating = false
		local ownHum = GetHumanoid(GetCharacter())
		if ownHum then
			camera.CameraSubject = ownHum
		end
		SpectateButton.Text = "Spectate Selected Player"
		SpectateButton.BackgroundColor3 = CONFIG.Secondary
		return
	end

	local targetHum = State.SelectedPlayer and GetHumanoid(GetCharacter(State.SelectedPlayer))
	if not targetHum then return end
	camera.CameraSubject = targetHum
	State.Spectating = true
	SpectateButton.Text
