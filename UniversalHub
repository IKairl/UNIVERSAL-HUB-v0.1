local function isItemCandidate(instance)
    return instance:IsA("BasePart") and instance:IsDescendantOf(CONFIG.ItemRoot)
end

local function refreshItems()
    clearList(itemList)
    local query = string.lower(itemFilter.Text)
    local count = 0
    for _, instance in ipairs(CONFIG.ItemRoot:GetDescendants()) do
        if isItemCandidate(instance) then
            local path = instance:GetFullName()
            local name = string.lower(instance.Name)
            if query == "" or string.find(name, query, 1, true)
                or string.find(string.lower(path), query, 1, true) then
                if count < CONFIG.MaxItemResults then
                    count += 1
                    addListEntry(itemList, instance.Name .. "  •  " .. path, function()
                        state.selectedItem = instance
                        manualItem.Text = instance.Name
                        selectedItemText.Text = "Selected item: " .. path
                    end)
                end
            end
        end
    end
    if count == 0 then addLabel(itemList, "No matching BaseParts found.", 26, 12, T.Muted) end
end

itemFilter:GetPropertyChangedSignal("Text"):Connect(refreshItems)
addButton(itemsPage, "Refresh item list", refreshItems)

addButton(itemsPage, "Find typed item name", function()
    local query = string.lower(manualItem.Text)
    if query == "" then return end

    local matches = {}
    for _, instance in ipairs(CONFIG.ItemRoot:GetDescendants()) do
        if isItemCandidate(instance) and string.lower(instance.Name) == query then
            table.insert(matches, instance)
        end
    end

    if #matches == 1 then
        state.selectedItem = matches[1]
        selectedItemText.Text = "Selected item: " .. matches[1]:GetFullName()
    elseif #matches > 1 then
        selectedItemText.Text = tostring(#matches) .. " exact matches. Use the list/path filter to choose the correct one."
    else
        state.selectedItem = nil
        selectedItemText.Text = "No exact matching BasePart found."
    end
end, T.Accent)

