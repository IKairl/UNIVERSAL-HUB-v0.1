local function Create(class, properties, parent)
	local object = Instance.new(class)

	for property, value in pairs(properties) do
		object[property] = value
	end

	object.Parent = parent
	return object
end

local function AddCorner(parent, radius)
	Create("UICorner", {
		CornerRadius = UDim.new(0, radius or 8),
	}, parent)
end

local function AddPadding(parent, amount)
	Create("UIPadding", {
		PaddingTop = UDim.new(0, amount),
		PaddingBottom = UDim.new(0, amount),
		PaddingLeft = UDim.new(0, amount),
		PaddingRight = UDim.new(0, amount),
	}, parent)
end

local function CreateLabel(parent, text, size, color, height)
	return Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 26),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextSize = size or 14,
		TextColor3 = color or CONFIG.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, parent)
end

local function CreateButton(parent, text, callback, color, height)
	local button = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, height or 40),
		BackgroundColor3 = color or CONFIG.Secondary,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextWrapped = true,
		AutoButtonColor = true,
	}, parent)

	AddCorner(button, 8)

	if callback then
		button.Activated:Connect(callback)
	end

	return button
end

local function CreateTextBox(parent, placeholder, initialText, height)
	local box = Create("TextBox", {
		Size = UDim2.new(1, 0, 0, height or 38),
		BackgroundColor3 = CONFIG.Secondary,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamMedium,
		PlaceholderText = placeholder,
		PlaceholderColor3 = CONFIG.Muted,
		Text = initialText or "",
		TextColor3 = CONFIG.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)

	AddCorner(box, 8)
	AddPadding(box, 10)

	return box
end

local function CreateList(parent, height)
	local list = Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, height or 170),
		BackgroundColor3 = CONFIG.Background,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, parent)

	AddCorner(list, 8)
	AddPadding(list, 8)

	Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, list)

	return list
end

local function ClearList(list)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject")
			and not child:IsA("UIListLayout")
			and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function CreateListEntry(parent, text, callback)
	local button = CreateButton(parent, text, callback, CONFIG.Secondary, 36)
	button.TextXAlignment = Enum.TextXAlignment.Left
	AddPadding(button, 8)
	return button
end

