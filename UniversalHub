local function RefreshPlayers()
	ClearList(PlayerList)
	local query = string.lower(PlayerSearch.Text)
	local matches = 0

	for _, player in ipairs(Players:GetPlayers()) do
		local nameLower = string.lower(player.Name)
		local displayLower = string.lower(player.DisplayName)

		if query == ""
			or string.find(nameLower, query, 1, true)
			or string.find(displayLower, query, 1, true) then

			matches += 1
			local labelText = string.format("%s (@%s)", player.DisplayName, player.Name)
			CreateListEntry(PlayerList, labelText, function()
				State.SelectedPlayer = player
				SelectedPlayerLabel.Text = "Selected player: " .. labelText
			end)
		end
	end

	if matches == 0 then
		CreateLabel(PlayerList, "No matching players found.", 12, CONFIG.Muted, 24)
	end
end

PlayerSearch:GetPropertyChangedSignal("Text"):Connect(RefreshPlayers)
Players.PlayerAdded:Connect(RefreshPlayers)
Players.PlayerRemoving:Connect(function(player)
	if State.SelectedPlayer == player then
		State.SelectedPlayer = nil
		State.PlayerLoop = false
		SelectedPlayerLabel.Text = "Selected player: None"
	end
	RefreshPlayers()
end)

CreateButton(PlayersPage, "Refresh Player List", RefreshPlayers)

CreateButton(PlayersPage, "Teleport to Selected Player", function()
	local target = State.SelectedPlayer
	if not target or target == LocalPlayer then return end
	local targetRoot = GetRoot(GetCharacter(target))
	if targetRoot then
		TeleportLocalToCFrame(targetRoot.CFrame)
	end
end, CONFIG.Accent)

