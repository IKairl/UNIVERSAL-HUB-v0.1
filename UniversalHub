--============================== TAB 2: PLAYERS ==============================

local playersPage = createPage("Players", 2)
addSection(playersPage, "Player Display", "Select a player. Movement actions affect only your local test character.")
local playerSearch = addTextBox(playersPage, "Search username or display name...")
local selectedPlayerText = addLabel(playersPage, "Selected player: None", 22, 12, T.Muted)
local playerList = addList(playersPage, 165)

local function refreshPlayers()
	clearList(playerList)
	local query = string.lower(playerSearch.Text)
	local found = 0
	for _, player in ipairs(Players:GetPlayers()) do
		local name = string.lower(player.Name)
		local display = string.lower(player.DisplayName)
		if query == "" or string.find(name, query, 1, true)
			or string.find(display, query, 1, true) then
			found += 1
			addListEntry(playerList, player.DisplayName .. "  (@" .. player.Name .. ")", function()
				state.selectedPlayer = player
				selectedPlayerText.Text = "Selected player: " .. player.Name
			end)
		end
	end
	if found == 0 then addLabel(playerList, "No matching players.", 26, 12, T.Muted) end
end

playerSearch:GetPropertyChangedSignal("Text"):Connect(refreshPlayers)
Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(function(player)
	if state.selectedPlayer == player then
		state.selectedPlayer = nil
		selectedPlayerText.Text = "Selected player: None"
		state.playerLoop = false
	end
	refreshPlayers()
end)
addButton(playersPage, "Refresh player list", refreshPlayers)

addButton(playersPage, "Teleport my character to selected player", function()
	local target = state.selectedPlayer
	if not target or target == LocalPlayer then return end
	local targetRoot = rootOf(target.Character)
	if targetRoot then moveLocalCharacter(targetRoot.CFrame) end
end, T.Accent)

local playerLoopButton
playerLoopButton = addButton(playersPage, "Loop teleport: OFF", function()
	state.playerLoop = not state.playerLoop
	playerLoopButton.Text = state.playerLoop and "Loop teleport: ON" or "Loop teleport: OFF"
	playerLoopButton.BackgroundColor3 = state.playerLoop and T.Good or T.Surface
end)

addButton(playersPage, "Stop player loop", function()
	state.playerLoop = false
	playerLoopButton.Text = "Loop teleport: OFF"
	playerLoopButton.BackgroundColor3 = T.Surface
end, T.Danger)

local spectateButton
spectateButton = addButton(playersPage, "Spectate selected player", function()
	local camera = workspace.CurrentCamera
	if not camera then return end

	if state.spectating then
		state.spectating = false
		local ownHumanoid = humanoidOf(character())
		if ownHumanoid then camera.CameraSubject = ownHumanoid end
		spectateButton.Text = "Spectate selected player"
		spectateButton.BackgroundColor3 = T.Surface
		return
	end

	local target = state.selectedPlayer
	local targetHumanoid = target and humanoidOf(target.Character)
	if not targetHumanoid then return end
	camera.CameraSubject = targetHumanoid
	state.spectating = true
	spectateButton.Text = "Stop spectating"
	spectateButton.BackgroundColor3 = T.Good
end)
refreshPlayers()

