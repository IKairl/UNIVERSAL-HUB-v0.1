local TabPages = {}
local TabButtons = {}

local function CreatePage(name)
    local page = Create("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false
    }, Content)

    local layout = Create("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    TabPages[name] = page
    return page
end

local function AddTab(name, order)
    local button = Create("TextButton", {
        Name = name,
        Size = UDim2.fromOffset(125, 34),
        BackgroundColor3 = CONFIG.Secondary,
        Text = name,
        TextColor3 = CONFIG.Muted,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        LayoutOrder = order
    }, TabBar)

    AddCorner(button, 8)

    local page = CreatePage(name)
    TabButtons[name] = button

    button.Activated:Connect(function()
        for tabName, tabPage in pairs(TabPages) do
            tabPage.Visible = tabName == name
        end

        for tabName, tabButton in pairs(TabButtons) do
            tabButton.BackgroundColor3 =
                tabName == name and CONFIG.Accent
                or CONFIG.Secondary

            tabButton.TextColor3 =
                tabName == name and CONFIG.Text
                or CONFIG.Muted
        end

        Content.CanvasPosition = Vector2.zero
    end)

    return page
end

