local function rebuildPlayerList()
    clearList(playerList)
    local query, count = string.lower(playerSearch.Text), 0
    for _, player in ipairs(Players:GetPlayers()) do
        local matches = query == ""
            or string.find(string.lower(player.Name), query, 1, true)
            or string.find(string.lower(player.DisplayName), query, 1, true)
        if matches then
            count += 1
            addListButton(playerList, player.DisplayName .. "  (@" .. player.Name .. ")", function()
                state.selectedPlayer = player
                selectedPlayerLabel.Text = "Selected player: " .. player.Name
            end)
        end
    end
    if count == 0 then label(playerList, "No matching players.", 28, 12, C.Muted) end
end

