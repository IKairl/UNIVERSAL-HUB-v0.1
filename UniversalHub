local function getCharacter()
    return LocalPlayer.Character
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function teleportLocalTo(targetCFrame)
    local character = getCharacter()
    if not character or not getRoot(character) or not targetCFrame then return false end
    character:PivotTo(targetCFrame + CONFIG.TeleportOffset)
    return true
end

local function create(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props) do obj[key] = value end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 9)}, parent)
end

local function addPadding(parent, amount)
    create("UIPadding", {
        PaddingTop = UDim.new(0, amount),
        PaddingBottom = UDim.new(0, amount),
        PaddingLeft = UDim.new(0, amount),
        PaddingRight = UDim.new(0, amount),
    }, parent)
end

local function label(parent, text, height, textSize, color)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height or 28),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = color or C.Text,
        TextSize = textSize or 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end

local function button(parent, text, callback, color)
    local b = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = color or C.Panel2,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = C.Text,
        TextSize = 13,
        TextWrapped = true,
    }, parent)
    corner(b, 8)
    if callback then b.Activated:Connect(callback) end
    return b
end

local function textBox(parent, placeholder, initialText)
    local box = create("TextBox", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = C.Panel2,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderText = placeholder,
        PlaceholderColor3 = C.Muted,
        Text = initialText or "",
        TextColor3 = C.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    corner(box, 8)
    addPadding(box, 10)
    return box
end

local function makeList(parent, height)
    local list = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, height or 180),
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
    }, parent)
    corner(list, 8)
    addPadding(list, 7)
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)
    return list
end

local function clearList(list)
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout")
            and not child:IsA("UIPadding") then child:Destroy() end
    end
end

local function addListButton(list, text, callback)
    local b = button(list, text, callback)
    b.Size = UDim2.new(1, -2, 0, 38)
    b.TextXAlignment = Enum.TextXAlignment.Left
    addPadding(b, 8)
    return b
end

