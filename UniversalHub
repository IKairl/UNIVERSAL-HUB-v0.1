local function createPage(name, order)
    local page = create("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Visible = false,
    }, content)
    addPadding(page, 13)
    create("UIListLayout", {
        Padding = UDim.new(0, 9),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    pages[name] = page

    local tab = create("TextButton", {
        Name = name .. "Tab",
        Size = UDim2.fromOffset(128, 35),
        BackgroundColor3 = C.Panel2,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = C.Muted,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        LayoutOrder = order,
    }, tabBar)
    corner(tab, 8)
    tabButtons[name] = tab

    tab.Activated:Connect(function()
        for pageName, pageObject in pairs(pages) do
            pageObject.Visible = pageName == name
            tabButtons[pageName].BackgroundColor3 = pageName == name and C.Accent or C.Panel2
            tabButtons[pageName].TextColor3 = pageName == name and C.Text or C.Muted
        end
        page.CanvasPosition = Vector2.zero
    end)
    return page
end

