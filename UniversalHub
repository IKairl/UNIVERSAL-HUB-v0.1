local function new(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function addCorner(object, radius)
    new("UICorner", {CornerRadius = UDim.new(0, radius or 9)}, object)
end

local function addPadding(object, amount)
    new("UIPadding", {
        PaddingTop = UDim.new(0, amount),
        PaddingBottom = UDim.new(0, amount),
        PaddingLeft = UDim.new(0, amount),
        PaddingRight = UDim.new(0, amount),
    }, object)
end

local function addLabel(parent, text, height, size, color)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height or 28),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = color or T.Text,
        TextSize = size or 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end

local function addButton(parent, text, callback, color, height)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, height or 40),
        BackgroundColor3 = color or T.Surface,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = T.Text,
        TextSize = 13,
        TextWrapped = true,
    }, parent)
    addCorner(b, 8)
    if callback then b.Activated:Connect(callback) end
    return b
end

local function addTextBox(parent, placeholder, initial)
    local box = new("TextBox", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = T.Surface,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderText = placeholder,
        PlaceholderColor3 = T.Muted,
        Text = initial or "",
        TextColor3 = T.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    addCorner(box, 8)
    addPadding(box, 10)
    return box
end

local function addList(parent, height)
    local frame = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, height or 180),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
    }, parent)
    addCorner(frame, 8)
    addPadding(frame, 7)
    new("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, frame)
    return frame
end

local function clearList(frame)
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("GuiObject")
            and not child:IsA("UIListLayout")
            and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function addListEntry(parent, text, callback)
